{
  "optionalMods": [
    {
      "glob": "mods/[自动第三人称]auto_third_person-neo-1.21.1-2.2.jar",
      "policy": "Optional",
      "group": "视角",
      "label": "自动第三人称（骑乘、滑翔等场景自动切第三人称）"
    },
    {
      "glob": "mods/[更真实的第一人称模型]firstperson-neoforge-2.7.2-mc1.21.1.jar",
      "policy": "Optional",
      "group": "视角",
      "label": "更真实的第一人称模型（低头能看到自己身体）"
    },
    {
      "glob": "mods/c2me-neoforge-mc1.21.1-0.4.0-alpha.0.120.jar",
      "policy": "Optional",
      "group": "性能",
      "label": "多线程区块生成（默认关闭；单机探索新地形时会与画面渲染抢 CPU，联机时由服务器承担生成，装了也用不上）"
    },
    {
      "glob": "mods/[是，史蒂夫模型]ysm-*.jar",
      "policy": "Optional",
      "defaultOn": true,
      "group": "外观",
      "label": "是，史蒂夫模型 (YSM)"
    }
  ],
  "overlays": [
    {
      "path": "config/iris.properties",
      "format": "Properties",
      "enforce": {
        "maxShadowRenderDistance": 16,
        "disableUpdateMessage": true
      },
      "createIfMissing": true
    },
    {
      "path": "options.txt",
      "format": "Properties",
      "seedKeys": {
        "graphicsMode": 0,
        "fov": 0,
        "soundCategory_master": 0.5,
        "soundCategory_music": 1.0,
        "simulationDistance": 8,
        "particles": 0,
        "key_iris.keybind.reload": "key.keyboard.unknown",
        "key_iris.keybind.toggleShaders": "key.keyboard.unknown",
        "key_iris.keybind.shaderPackSelection": "key.keyboard.unknown",
        "key_iris.keybind.wireframe": "key.keyboard.unknown",
        "key_key.pasterdream.teleportation": "key.keyboard.j",
        "key_key.crawlondemand.crawl": "key.keyboard.c",
        "key_key.crawlondemand.toggle_crawl": "key.keyboard.unknown",
        "key_key.pasterdream.cloak_activate": "key.keyboard.n",
        "key_key.yes_steve_model.animation_roulette.desc": "key.keyboard.z:ALT",
        "key_key.toms_storage.open_terminal": "key.keyboard.b:ALT",
        "key_key.deeperdarker.boost": "key.keyboard.unknown",
        "key_key.yes_steve_model.debug_animation.desc": "key.keyboard.unknown",
