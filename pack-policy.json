{
  "optionalMods": [
    {
      "glob": "mods/[自动第三人称]auto_third_person-neo-1.21.1-2.2.jar",
      "policy": "Optional",
      "group": "视角",
      "label": "自动第三人称（骑乘、滑翔等场景自动切第三人称）"
    },
    {
      "glob": "mods/[更真实的第一人称模型]firstperson-neoforge-2.7.2-mc1.21.1.jar",
      "policy": "Optional",
      "group": "视角",
      "label": "更真实的第一人称模型（低头能看到自己身体）"
    },
    {
      "glob": "mods/c2me-neoforge-mc1.21.1-0.4.0-alpha.0.120.jar",
      "policy": "Optional",
      "group": "性能",
      "label": "多线程区块生成（默认关闭；单机探索新地形时会与画面渲染抢 CPU，联机时由服务器承担生成，装了也用不上）"
    },
    {
      "glob": "mods/[是，史蒂夫模型]ysm-*.jar",
      "policy": "Optional",
      "defaultOn": true,
      "group": "外观",
      "label": "是，史蒂夫模型 (YSM)"
    }
  ],
  "overlays": [
    {
      "path": "CustomSkinLoader/CustomSkinLoader.json",
      "format": "Json",
      "enforce": {
        "loadlist": [
          {
            "name": "BetterMC",
            "type": "CustomSkinAPI",
            "root": "https://mc.muxigame.com/api/v1/skins/csl/"
          }
        ],
        "enableLocalProfileCache": false
      },
      "createIfMissing": true
    },
    {
      "path": "config/iris.properties",
      "format": "Properties",
      "enforce": {},
      "createIfMissing": true
    },
    {
      "path": "options.txt",
      "format": "Properties",
      "enforce": {},
      "removeFromList": {
        "resourcePacks": [
          "file/PCL2 Skin.zip",
          "PCL2 Skin.zip",
          "mod/pasterdream:packs/paster_vanilla_ui",
          "builtin/paster_vanilla_ui"
        ]
      },
      "createIfMissing": false
    },
    {
      "path": "config/memorysettings.json",
      "format": "Json",
      "enforce": {},
      "createIfMissing": false
    },
    {
      "path": "config/iceandfire/iaf-client.json",
      "format": "Json",
      "enforce": {},
      "createIfMissing": false
    },
    {
      "path": "config/sodium-options.json",
      "format": "Json",
      "createIfMissing": false,
      "enforce": {}
    },
    {
      "path": "config/fml.toml",
      "format": "Toml",
      "enforce": {
        "disableConfigWatcher": true,
        "dependencyOverrides/sable": [
          "-scalablelux"
        ]
      },
      "createIfMissing": false
    },
    {
      "path": "config/sodiumdynamiclights-client.toml",
      "format": "Toml",
      "createIfMissing": false,
      "enforce": {}
    },
    {
      "path": "config/sodiumextras-client.toml",
      "format": "Toml",
      "createIfMissing": false,
      "enforce": {}
    },
    {
      "path": "config/shouldersurfing-client.toml",
      "format": "Toml",
      "enforce": {},
      "createIfMissing": false
    },
    {
      "path": "config/PasterDream-Client.toml",
      "format": "Toml",
      "enforce": {},
      "createIfMissing": false
    },
    {
      "path": "config/PasterDream-Client.toml",
      "format": "Toml",
      "enforce": {},
      "createIfMissing": true
    },
    {
      "path": "config/butchercraft-common.toml",
      "format": "Toml",
      "enforce": {},
      "createIfMissing": false
    },
    {
      "path": "config/CustomNpcs.cfg",
      "format": "Properties",
      "enforce": {},
      "createIfMissing": true
    },
    {
      "path": "config/packanalytics-common.toml",
      "format": "Toml",
      "enforce": {
        "Metrics Endpoint URL": ""
      },
      "createIfMissing": false
    }
  ],
  "excludedRoots": [
    "versions",
    "fancymenu_data",
    "options.txt",
    "saves",
    "screenshots",
    "logs",
    "accounts",
    "libraries",
    "assets",
    "runtime"
  ],
  "excludedFiles": [
    "config/muxi-game-core.json",
    "config/resourceful-config-web.json",
    "config/yes_steve_model/blacklist.txt"
  ],
  "note": "No launcher credentials or Minecraft binaries. C2ME is in optional-mods, disabled by default."
}
