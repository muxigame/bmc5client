      "enforce": {
        "skipMultiplayerWarning": true
      },
      "removeFromList": {
        "resourcePacks": [
          "mod/pasterdream:packs/paster_vanilla_ui",
          "builtin/paster_vanilla_ui"
        ]
      },
      "createIfMissing": false
    },
    {
      "path": "config/memorysettings.json",
      "format": "Json",
      "enforce": {
        "disableWarnings/disableWarnings": true
      },
      "createIfMissing": false
    },
    {
      "path": "config/iceandfire/iaf-client.json",
      "format": "Json",
      "enforce": {
        "client/customMainMenu": false
      },
      "createIfMissing": false
    },
    {
      "path": "config/sodium-options.json",
      "format": "Json",
      "seedKeys": {
        "quality/weather_quality": "FAST"
      },
      "createIfMissing": false
    },
    {
      "path": "config/fml.toml",
      "format": "Toml",
      "enforce": {
        "disableConfigWatcher": true,
        "dependencyOverrides/sable": [
          "-scalablelux"
        ]
      },
      "createIfMissing": false
    },
    {
      "path": "config/sodiumdynamiclights-client.toml",
      "format": "Toml",
      "seedKeys": {
        "sodiumdynamiclights/mode": "FANCY"
      },
      "createIfMissing": false
    },
    {
      "path": "config/sodiumextras-client.toml",
      "format": "Toml",
      "seedKeys": {
        "embeddiumextras/performance/distanceCulling/tileEntities/cullingMaxDistanceX": 4096,
        "embeddiumextras/performance/distanceCulling/entities/cullingMaxDistanceX": 9216,
        "embeddiumextras/general/fpsDisplay": "ADVANCED"
      },
      "createIfMissing": false
    },
    {
      "path": "config/shouldersurfing-client.toml",
      "format": "Toml",
      "enforce": {
        "perspective/third_person_front_enabled": false,
        "perspective/third_person_back_enabled": false
      },
      "createIfMissing": false
    },
    {
      "path": "config/PasterDream-Client.toml",
      "format": "Toml",
      "enforce": {
        "HUD/enable mod ui": false,
        "HUD/paster health hud": false
      },
      "createIfMissing": false
    },
    {
      "path": "config/butchercraft-common.toml",
      "format": "Toml",
      "enforce": {
        "mobs/armyHoodChanceMultiplier": 0.0
      },
      "createIfMissing": false
    },
    {
      "path": "config/CustomNpcs.cfg",
      "format": "Properties",
      "enforce": {
        "InventoryGuiEnabled": false
      },
      "createIfMissing": true
    }
  ],
  "excludedRoots": [
    "versions",
    "fancymenu_data",
    "options.txt",
    "saves",
    "screenshots",
    "logs",
    "accounts",
    "libraries",
    "assets",
    "runtime"
  ],
  "excludedFiles": [
    "config/muxi-game-core.json",
    "config/resourceful-config-web.json",
    "config/yes_steve_model/blacklist.txt"
  ],
  "note": "No launcher credentials or Minecraft binaries. C2ME is in optional-mods, disabled by default."
}
